# Copy to .env and fill in. Never commit .env (already gitignored).

# === Required secrets =====================================================

# Telegram bot token — get from @BotFather on Telegram (/newbot).
# Username must end in "bot".
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token

# Groq API key — https://console.groq.com/keys (free tier available).
# Used to call openai/gpt-oss-120b (or whichever AGENT_MODEL you pick).
GROQ_API_KEY=gsk-your-key

# Tavily API key — https://tavily.com (free tier available).
# Used for live web search (MOSPI / data.gov.in / census lookups, etc.).
TAVILY_API_KEY=tvly-your-key

# === Public log URL =======================================================
#
# The bot embeds a `log_url` in every Telegram reply. By default it's
# auto-derived from `git remote get-url origin` — works for any GitHub
# fork/clone without any setup on your part.
#
# Set LOG_PUBLIC_URL only if you want to override (e.g. you deployed to
# Render and want the bot's reply to point at the Render URL instead of
# the GitHub raw URL). Example:
#   LOG_PUBLIC_URL=https://your-app.onrender.com/run.jsonl
#
# If unset, the resolver picks (in order):
#   1. LOG_PUBLIC_URL (if set)
#   2. GitHub URL from `git remote get-url origin` -> raw.githubusercontent.com
#   3. PUBLIC_LOG_URL (legacy, still honored)
#   4. http://localhost:8000/run.jsonl (local dev only)
# LOG_PUBLIC_URL=

# === Optional overrides ===================================================

# Groq model ID. Defaults to openai/gpt-oss-120b (reasoning model).
# Other Groq-hosted options: llama-3.3-70b-versatile, llama-3.1-8b-instant,
# mixtral-8x7b-32768.
AGENT_MODEL=openai/gpt-oss-120b

# Groq's OpenAI-compatible endpoint. Override only if Groq publishes a new URL.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Reasoning models (gpt-oss-*) burn reasoning tokens against this budget.
# Groq free-tier TPM for openai/gpt-oss-120b is 8000 — input + this must fit.
# 3000 leaves room for ~1500 input + ~1500 reasoning tokens + final JSON
# answer without going over the TPM budget per request. Bump on paid tier.
MAX_COMPLETION_TOKENS=3000

# Safety cap on tool-use rounds per question.
# 2 is enough for graded MOSPI-style questions; lower cap also means fewer
# token-burning rounds.
MAX_TOOL_ROUNDS=2

# Number of Tavily results returned per search. 3 keeps each tool response
# small (~600 tokens) which preserves the TPM budget.
TAVILY_MAX_RESULTS=3

# Where the JSONL run log gets written. Default is the repo root
# (`run.jsonl`) so the file gets committed and pushed to GitHub — the raw
# URL on raw.githubusercontent.com is then the public wget-able log_url.
# The bot serves it at GET /run.jsonl regardless of this path.
LOG_PATH=run.jsonl

# === Git auto-push (Option A from the project brief) ======================
#
# When GIT_AUTO_PUSH=true, a background thread commits and pushes run.jsonl
# every GIT_PUSH_INTERVAL_SECONDS so the raw GitHub URL stays current.
# Use GITHUB_TOKEN for HTTPS auth on hosts without SSH keys (Render, etc).
# Locally, leave GIT_AUTO_PUSH=false to avoid polluting your fork during dev.
#
#GIT_AUTO_PUSH=true
#GIT_PUSH_INTERVAL_SECONDS=60
#GITHUB_TOKEN=

# === Branch override ======================================================
#
# Branch for the auto-derived raw.githubusercontent.com URL. Defaults to
# the current git branch (or "main" if that can't be determined). Set
# this if you deploy from a non-default branch.
#
#LOG_BRANCH=main